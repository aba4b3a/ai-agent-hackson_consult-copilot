{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consult-copilot.example.com/schemas/knowledge_agent_output.schema.json",
  "title": "KnowledgeAgentOutput",
  "type": "object",
  "required": ["company_id", "kpi_candidates", "focus_metric_candidates"],
  "additionalProperties": true,
  "properties": {
    "company_id": { "type": "string", "minLength": 1 },
    "company_profile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "summary": { "type": "string" },
        "business_structure": { "type": "string" },
        "customer_structure": { "type": "string" },
        "product_service_structure": { "type": "string" },
        "competition": { "type": "string" }
      }
    },
    "kpi_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kpi_candidate_id", "kpi_name"],
        "additionalProperties": true,
        "properties": {
          "kpi_candidate_id": { "type": "string", "minLength": 1 },
          "common_kpi_id": { "type": ["string", "null"] },
          "kpi_name": { "type": "string", "minLength": 1 },
          "kpi_domain": { "type": ["string", "null"] },
          "kpi_type": {
            "type": ["string", "null"],
            "enum": ["result", "leading", null]
          },
          "description": { "type": ["string", "null"] },
          "calculation_hint": { "type": ["string", "null"] },
          "data_source_hint": { "type": ["string", "null"] },
          "measurement_frequency": { "type": ["string", "null"] },
          "reason": { "type": ["string", "null"] },
          "source_answer_event_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "importance_score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "focus_metric_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["focus_metric_candidate_id", "metric_name"],
        "additionalProperties": true,
        "properties": {
          "focus_metric_candidate_id": { "type": "string", "minLength": 1 },
          "metric_name": { "type": "string", "minLength": 1 },
          "metric_category": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] },
          "related_kpi_candidate_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "observation_signal_types": {
            "type": "array",
            "items": { "type": "string" }
          },
          "calculation_hint": { "type": ["string", "null"] },
          "data_source_hint": { "type": ["string", "null"] },
          "measurement_frequency": { "type": ["string", "null"] },
          "trigger_condition": { "type": ["string", "null"] },
          "followup_policy": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "priority_score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "observation_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observation_signal_id", "signal_name"],
        "additionalProperties": true,
        "properties": {
          "observation_signal_id": { "type": "string", "minLength": 1 },
          "signal_name": { "type": "string", "minLength": 1 },
          "signal_category": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] },
          "detection_rule": { "type": ["string", "null"] },
          "severity": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "wiki_files": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "human_review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_type", "target_id", "title"],
        "additionalProperties": true,
        "properties": {
          "target_type": {
            "type": "string",
            "enum": [
              "kpi_candidate",
              "focus_metric_candidate",
              "custom_table",
              "wiki_update",
              "schema_migration",
              "observation_signal",
              "other"
            ]
          },
          "target_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "reason": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
