APP_ENV=local
# Real Gemini extraction: set MOCK_MODE=false AND provide GEMINI_API_KEY.
# With no key (or MOCK_MODE=true), extraction falls back to the deterministic
# keyword-based mock so local dev and tests run without a model call.
MOCK_MODE=true
GCP_PROJECT=local-project
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set true when GEMINI_API_KEY is a Vertex AI key (aiplatform.googleapis.com).
# Leave false for a Gemini Developer API / AI Studio key.
USE_VERTEXAI=false
GCP_LOCATION=global
