# =============================================================
# agent/.env.example
# 実装（agents/config.py）が実際に読む変数のみを記載しています。
# 詳細なハマりどころは agent/GEMINI_SETUP.md を参照。
# =============================================================

# 実行環境 (local または production)
APP_ENV=local

# --- モデル選択（有効なのは MODEL_ID のみ） ---
# ローカルLLM（Ollama）を使う場合:
#   MODEL_ID=ollama/gemma4:12b
# Gemini（Vertex AI, APIキー方式）を使う場合:
#   MODEL_ID=gemini-3.1-flash-lite など
MODEL_ID=ollama/gemma4:12b

# --- Gemini（Vertex AI express・APIキー方式）を使う場合に設定 ---
# 注意:
#  - GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION は設定しないこと
#    （設定すると SDK が APIキーを破棄して ADC 認証に切替わり 401 になる）
#  - GOOGLE_API_KEY も設定しないこと（GEMINI_API_KEY より優先されてしまう）
#  - キーは AQ. で始まる Vertex express キー。貼り付け時に "=" が二重に
#    ならないよう注意（GEMINI_API_KEY==AQ... は認証失敗する）
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_API_KEY=

# --- Ollama（ローカルLLM）を使う場合 ---
# Docker compose 内から参照する場合はサービス名を使う
OLLAMA_API_BASE=http://ollama-ai:11434

# --- GCP / BigQuery ---
# ローカルはエミュレータ（docker-compose の bigquery-emulator）を使用。
# PROJECT_ID はエミュレータ起動時の --project と一致させること。
PROJECT_ID=local-project
LOCATION=asia-northeast1
BIGQUERY_EMULATOR_HOST=http://bigquery-emulator:9050
BQ_DATASET_PREFIX=cda
BQ_GRAPH_NAME=KnowledgeGraph

# --- その他 ---
DRY_RUN=true
WIKI_BUCKET=
