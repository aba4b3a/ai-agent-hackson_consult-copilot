# =============================================================
# agent/.env.example
# 実装（agents/config.py）が実際に読む変数を記載しています。
# 認証まわりのハマりどころは agent/GEMINI_SETUP.md を参照。
# =============================================================

# 実行環境 (local または production)
APP_ENV=local

# BigQuery/GCSの書き込み先(モデルバックエンドとは独立)
GCP_PROJECT=local-project
PROJECT_ID=local-project
LOCATION=asia-northeast1

# ローカルは BigQuery エミュレータを使用。
# PROJECT_ID はエミュレータ起動時の --project（docker-compose: local-project）と一致させること。
# BQ_DATASET_PREFIX は back/.env の値と一致させること。
BIGQUERY_EMULATOR_HOST=http://bigquery-emulator:9050
BQ_DATASET_PREFIX=consultant_copilot
BQ_GRAPH_NAME=KnowledgeGraph
DRY_RUN=true
WIKI_BUCKET=

# モデル設定: Gemini Enterprise (Vertex AI 経由の Gemini) をADKネイティブ統合で利用
# LiteLLM経由の vertex_ai/<model> ではなく、ADKが公式推奨するネイティブGemini統合を使う
MODEL_ID=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=asia-northeast1
# サービスアカウントJSONへの絶対パス。Secret Managerではなくローカルファイルで管理する場合のみ使用し、
# リポジトリにはコミットしないこと(.gitignore済み)。
GOOGLE_APPLICATION_CREDENTIALS=/app/secret.json

# --- 代替: APIキー（Vertex express, AQ. 形式キー）方式を使う場合 ---
# この方式では上の GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION /
# GOOGLE_APPLICATION_CREDENTIALS を設定しないこと
# （project/location があると SDK がAPIキーを破棄して ADC 認証に切替わり 401 になる）。
# GOOGLE_API_KEY も設定しないこと（GEMINI_API_KEY より優先されてしまう）。
#GEMINI_API_KEY=

# --- 代替: ローカルLLM（Ollama）を使う場合 ---
# Docker compose 内から参照する場合はサービス名を使う
#MODEL_ID=ollama/gemma4:12b
#OLLAMA_API_BASE=http://ollama-ai:11434
