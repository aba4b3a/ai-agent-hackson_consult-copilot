# Root env for docker-compose interpolation.
# Copy to `.env` (git-ignored) and fill in real values. Do NOT commit `.env`.

# Google Gemini API key used by the agent service for real extraction.
# Leave empty to keep the agent's deterministic mock extractor (no model call,
# no cost). Provide a valid key to enable real Gemini extraction via `make dev`.
# docker-compose defaults the agent to the Vertex AI backend (USE_VERTEXAI=true),
# so this should be a Vertex AI key. Override GCP_LOCATION if needed.
GEMINI_API_KEY=
GCP_LOCATION=global
