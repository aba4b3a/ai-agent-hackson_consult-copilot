APP_NAME="Continuous Discovery Agent API"
APP_ENV="local"
DEBUG="true"
DRY_RUN="true"

# ローカルはBigQueryエミュレータを使用。PROJECT_ID はエミュレータ起動時の
# --project（docker-compose: local-project）と一致させること。
PROJECT_ID="local-project"
LOCATION="asia-northeast1"
BIGQUERY_EMULATOR_HOST="http://bigquery-emulator:9050"
BQ_DATASET_PREFIX="consultant_copilot"
BQ_GRAPH_NAME="KnowledgeGraph"
WIKI_BUCKET="your-cda-wiki-bucket"
STORAGE_EMULATOR_ROOT=".local_storage"

# back内のADKエージェント（agent_runtime）が使うモデル
MODEL_ID="gemini-3.1-pro"

# copilot等がリクエストを転送する agent サービスのURL。
# Docker compose 内では localhost ではなくサービス名を使うこと。
AGENT_BASE_URL="http://agent:8080"

# back内のADKエージェントで Gemini（Vertex express・APIキー方式）を使う場合に設定。
# 注意事項は agent/GEMINI_SETUP.md と同じ（GOOGLE_CLOUD_PROJECT等は設定しない）。
#GOOGLE_GENAI_USE_VERTEXAI="true"
#GEMINI_API_KEY=""
