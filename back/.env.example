APP_ENV=local
MOCK_MODE=true
GCP_PROJECT=local-project
GCS_BUCKET=continuous-discovery-local
BIGQUERY_DATASET=continuous_discovery
ELASTICSEARCH_ENDPOINT=http://localhost:9200
GEMINI_MODEL=gemini-2.5-flash
BIGQUERY_EMULATOR_HOST=http://localhost:9050
AGENT_BASE_URL=http://localhost:8080
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
# Set true to route extraction to the agent service (real Gemini when the
# agent has GEMINI_API_KEY). Default false uses the local keyword extractor.
USE_AGENT_EXTRACTION=false
